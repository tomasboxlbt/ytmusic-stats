# Google AdSense (opcional). Sin VITE_ADSENSE_CLIENT no se cargan anuncios.
# ID de editor, con el prefijo "ca-": AdSense > Cuenta > Información de la cuenta
VITE_ADSENSE_CLIENT=ca-pub-0000000000000000
# Laterales para pantallas de 1640 px o más (AdSense > Anuncios > Por bloque de anuncios > Display, vertical)
VITE_ADSENSE_SLOT_LEFT=0000000000
VITE_ADSENSE_SLOT_RIGHT=0000000000
# Banner horizontal responsive para pantallas de menos de 1640 px (Display, horizontal / adaptable)
VITE_ADSENSE_SLOT_BANNER=0000000000
# true = mostrar recuadros de prueba en lugar de anuncios (para ver el layout en desarrollo)
VITE_ADSENSE_PREVIEW=false
